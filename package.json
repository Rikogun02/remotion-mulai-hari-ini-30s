{
  "name": "remotion-30-detik-mulai-hari-ini",
  "version": "1.0.0",
  "private": true,
  "description": "Video motivasi 30 detik dengan Remotion, VO Indonesia offline, dan subtitle sinkron.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "audio": "python3 scripts/generate-audio.py",
    "pre-render": "npm run audio",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.ts MainVideo out/video.mp4 --codec=h264"
  },
  "dependencies": {
    "@remotion/cli": "4.0.310",
    "remotion": "4.0.310",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.7.2"
  }
}